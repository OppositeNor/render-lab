${cue "key" {opening demoRoom panelHidden 1.0 {' {voxelgiMix 1.0}}}}
${cue "key" {' {motion {' {cameraPath {' {pose 20.0 18.0 6.4} {pose 32.0 22.0 6.0}}}}}}}

