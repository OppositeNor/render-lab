  "controls.cubemap_cross": "cubemap cross",
  "controls.cubemap_hint": "What a probe's bake stores: six 90-degree faces rendered from the probe's position, prefiltered into six mips (GGX, mip = roughness × 5). The cross unfolds them; the mirror ball (O3DE's visualization sphere: white, metallic, roughness 0) reflects them.",
  "controls.faces_baked": "faces baked",
  "controls.mirror_ball": "mirror ball",
  "formula.room": "{@ formula=\"\\begin{aligned}L &= \\lit{1}{L_d} + \\lit{2}{L_s} + \\lit{3}{L_d^{\\,\\mathrm{IBL}} + L_s^{\\,\\mathrm{IBL}}}\\end{aligned}\" display=yes colors=\"#8fe3a0,#ff8fc8,#64dfd1\"}",
  "formula.surface": "{@ formula=\"\\begin{aligned}\\mathrm{albedo} &= \\lit{1}{\\mathrm{base}\\,(1-\\mathrm{metallic})}\\\\[0.25pt]F_0 &= \\lit{2}{\\mathrm{lerp}(0.08\\,\\mathrm{factor},}\\\\[0.25pt] &\\qquad\\lit{2}{\\mathrm{base},\\ \\mathrm{metallic})}\\\\[0.25pt]r &= \\lit{3}{\\max(\\mathrm{roughness},\\ 0.024)}\\\\[0.25pt]\\alpha &= \\lit{3}{r^2,\\quad \\alpha^2 = r^4}\\end{aligned}\" display=yes colors=\"#8fe3a0,#ff8fc8,#64dfd1\"}",
  "formula.specular": "{@ formula=\"\\begin{aligned}f &= \\lit{1}{D}\\cdot \\lit{2}{G}\\cdot \\lit{3}{F}\\cdot \\lit{4}{(N{\\cdot}L)}\\\\[0.5pt]D &= \\lit{1}{\\alpha^2\\,/\\,\\pi\\big((N{\\cdot}H)^2(\\alpha^2-1)+1\\big)^2}\\\\[0.5pt]G &= \\lit{2}{0.5\\,/\\,(\\Lambda_V+\\Lambda_L)}\\\\[0.5pt]\\Lambda_V &= \\lit{2}{(N{\\cdot}L)\\sqrt{(N{\\cdot}V)^2(1-\\alpha^2)+\\alpha^2}}\\\\[0.5pt]F &= \\lit{3}{F_0+(1-F_0)(1-H{\\cdot}V)^5}\\end{aligned}\" display=yes colors=\"#ff8fc8,#ffa14a,#eef6ff,#ffd98a\"}",
  "formula.diffuse": "{@ formula=\"\\begin{aligned}L_d &= \\lit{1}{\\dfrac{\\mathrm{albedo}}{\\pi}\\,(N{\\cdot}L)}\\\\[3pt]&\\quad\\cdot\\lit{2}{\\big(1-F_r(N{\\cdot}V)\\big)}\\\\[3pt]F_r &= F_0+\\big(\\lit{3}{\\max(1-r,\\ F_0)}-F_0\\big)\\\\[3pt]&\\quad\\cdot(1-N{\\cdot}V)^5\\end{aligned}\" display=yes colors=\"#8fe3a0,#8fe3a0,#ff8fc8\"}",
  "formula.multiscatter": "{@ formula=\"\\begin{aligned}\\mathrm{comp} &= 1+\\lit{2}{F_0}\\left(\\dfrac{1}{\\lit{1}{A+B}}-1\\right)\\end{aligned}\" display=yes colors=\"#64dfd1,#ff8fc8\"}",
  "formula.pointlight": "{@ formula=\"\\begin{aligned}E &= \\lit{1}{\\dfrac{I}{\\max(d^2,\\ 10^{-6})}}\\,\\lit{2}{\\big(1-f^2\\big)^2}\\\\[3pt]f &= d^2\\,/\\,\\lit{3}{r^2}\\end{aligned}\" display=yes colors=\"#eef6ff,#ffd98a,#ffd98a\"}",
  "formula.ibl": "{@ formula=\"\\begin{aligned}L_s &= \\lit{1}{L_{\\mathrm{pre}}(R,\\ 5\\,r)}\\,\\lit{2}{(F_0\\,A+B)}\\,\\lit{3}{\\mathrm{comp}}\\\\[3pt]L_d &= \\lit{4}{\\mathrm{albedo}\\cdot E(N)\\,/\\,\\pi}\\end{aligned}\" display=yes colors=\"#ff6fb5,#ffa14a,#eef6ff,#8fe3a0\"}",
  "formula.clearcoat": "{@ formula=\"\\begin{aligned}F_0 &\\leftarrow \\lit{1}{\\mathrm{lerp}(F_0,\\ f^2,\\ c)}\\\\[2.5pt]f &= (1-5\\sqrt{F_0})\\,/\\,(5-\\sqrt{F_0})\\\\[2.5pt]F_c &= \\lit{2}{F(H{\\cdot}L,\\ 0.04)\\,c}\\\\[2.5pt]f_s &\\leftarrow \\lit{3}{f_s\\,(1-F_c)}+\\lit{2}{D_c\\,G_c\\,F_c\\,(N{\\cdot}L)}\\\\[2.5pt]G_c &= 0.25\\,/\\,\\max\\big((H{\\cdot}L)^2,\\ 10^{-4}\\big)\\\\[2.5pt]f_d &\\leftarrow \\lit{4}{f_d\\,\\big(1-F(H{\\cdot}V,\\ 0.04)\\,c\\big)}\\end{aligned}\" display=yes colors=\"#ff8fc8,#b49cff,#ff8fc8,#8fe3a0\"}",
  "formula.culling": "{@ formula=\"\\begin{aligned}&\\lit{1}{\\big\\|\\max(0,\\ |c-p|-h)\\big\\|^2} < r^2\\\\[1pt]&\\lit{2}{\\mathrm{mask}\\wedge\\mathrm{bits}(z\\pm r)} \\ne 0\\\\[1pt]\\mathrm{bin} &= \\lit{3}{\\lfloor \\min(f,\\ 0.999999)\\,2^k\\rfloor}\\\\[1pt]f &= (z-z_n)\\,/\\,(z_f-z_n)\\\\[1pt]k &= \\mathrm{round}(\\mathrm{clamp}(\\ell,\\ 0,\\ 3))\\\\[1pt]\\ell &= \\log_2(z_f-z_n)\\end{aligned}\" display=yes colors=\"#64dfd1,#64dfd1,#ffd166\"}",
  "formula.decals": "{@ formula=\"\\begin{aligned}a &= \\lit{1}{\\alpha\\cdot\\mathrm{opacity}\\cdot\\mathrm{lerp}(1,\\ s,\\ k)}\\\\[3pt]s &= \\lit{1}{\\mathrm{smoothstep}(0.55,\\ 1,\\ N_v{\\cdot}z)}\\\\[3pt]\\mathrm{albedo} &\\leftarrow \\lit{2}{\\mathrm{lerp}(\\mathrm{albedo},\\ b,\\ a)}\\\\[3pt]b &= c\\,f\\,\\mathrm{base}\\\\[3pt]N &\\leftarrow \\lit{3}{\\mathrm{norm}\\,\\mathrm{lerp}(N,\\ N_{\\mathrm{map}},\\ a_n)}\\end{aligned}\" display=yes colors=\"#64dfd1,#8fe3a0,#6be3b0\"}",
  "formula.transmission": "{@ formula=\"\\begin{aligned}T &= \\lit{1}{\\mathrm{sat}\\big(V{\\cdot}{-}\\widehat{(L+N\\,d)}\\big)^{p}\\,s}\\\\[3pt]A &= \\lit{2}{e^{-t\\,k}\\,\\mathrm{sat}(1-t)}\\\\[3pt]t &= \\max(0,\\ \\mathrm{thickness})\\\\[3pt]L_d &\\mathrel{+}= \\lit{3}{\\mathrm{tint}\\cdot T\\,A\\,E_L}\\end{aligned}\" display=yes colors=\"#8fb8ff,#64dfd1,#8fe3a0\"}",
  "formula.reflections": "{@ formula=\"\\begin{aligned}w_i &= \\lit{1}{1 \\text{ in inner}_i,\\ \\text{else } \\ell_i}\\\\[3pt]W &= \\lit{1}{\\textstyle\\sum_i w_i}\\\\[3pt]R &= \\lit{2}{(1-\\min(W,1))\\,G}\\\\[3pt]&\\quad+\\lit{3}{\\textstyle\\sum_i P_i\\,w_i\\,/\\max(1,W)}\\\\[3pt]R_{\\text{inner}} &= \\lit{3}{P_{\\text{last}}}\\end{aligned}\" display=yes colors=\"#64dfd1,#ffd98a,#ff6fb5\"}",
  "formula.ssao": "{@ formula=\"\\begin{aligned}w_k &= \\lit{1}{1\\,/\\,(|o_k-p|^2+0.07)}\\\\[3pt]\\mathrm{AO} &= \\lit{1}{\\textstyle\\sum_k w_k\\,\\mathrm{sat}(n\\cdot\\hat d_k)\\,/\\sum_k w_k}\\\\[3pt]v &= \\lit{2}{(1-\\mathrm{AO}\\cdot s)^{2.2}},\\ \\ 52\\ \\text{samples}\\\\[3pt]L_d &\\leftarrow \\lit{3}{L_d\\cdot \\mathrm{up}(\\mathrm{blur}(v))}\\end{aligned}\" display=yes colors=\"#64dfd1,#ffd98a,#8fe3a0\"}",
