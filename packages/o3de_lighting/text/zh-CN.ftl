formula-cascades = { FORMULA("\\begin{aligned}u_i &= \\lit{1}{n + (f-n)\\,\\tfrac{i+1}{4}}\\\\[3pt]\\ell_i &= \\lit{1}{n\\,(f/n)^{(i+1)/4}}\\\\[3pt]d_i &= \\lit{2}{r\\,\\ell_i + (1-r)\\,u_i}\\\\[3pt]R_i &= \\lit{3}{\\mathrm{sphere}(d_{i-1},\\ d_i)}\\\\[3pt]\\text{lo, hi} &= \\lit{4}{\\lfloor\\cdot/\\text{texel}\\rfloor\\,\\text{texel}}\\end{aligned}", display: "yes", colors: "#64dfd1,#8fb8ff,#ffd98a,#ff8fc8") }
