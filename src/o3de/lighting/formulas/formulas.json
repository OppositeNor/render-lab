{
 "room": "\\begin{aligned}L &= \\lit{1}{#8fe3a0}{L_d} + \\lit{2}{#ff8fc8}{L_s} + \\lit{3}{#64dfd1}{L_d^{\\,\\mathrm{IBL}} + L_s^{\\,\\mathrm{IBL}}}\\end{aligned}",
 "surface": "\\begin{aligned}\\mathrm{albedo} &= \\lit{1}{#8fe3a0}{\\mathrm{base}\\,(1-\\mathrm{metallic})}\\\\[0.25pt]F_0 &= \\lit{2}{#ff8fc8}{\\mathrm{lerp}(0.08\\,\\mathrm{factor},}\\\\[0.25pt] &\\qquad\\lit{2}{#ff8fc8}{\\mathrm{base},\\ \\mathrm{metallic})}\\\\[0.25pt]r &= \\lit{3}{#64dfd1}{\\max(\\mathrm{roughness},\\ 0.024)}\\\\[0.25pt]\\alpha &= \\lit{3}{#64dfd1}{r^2,\\quad \\alpha^2 = r^4}\\end{aligned}",
 "specular": "\\begin{aligned}f &= \\lit{1}{#ff8fc8}{D}\\cdot \\lit{2}{#ffa14a}{G}\\cdot \\lit{3}{#eef6ff}{F}\\cdot \\lit{4}{#ffd98a}{(N{\\cdot}L)}\\\\[0.5pt]D &= \\lit{1}{#ff8fc8}{\\alpha^2\\,/\\,\\pi\\big((N{\\cdot}H)^2(\\alpha^2-1)+1\\big)^2}\\\\[0.5pt]G &= \\lit{2}{#ffa14a}{0.5\\,/\\,(\\Lambda_V+\\Lambda_L)}\\\\[0.5pt]\\Lambda_V &= \\lit{2}{#ffa14a}{(N{\\cdot}L)\\sqrt{(N{\\cdot}V)^2(1-\\alpha^2)+\\alpha^2}}\\\\[0.5pt]F &= \\lit{3}{#eef6ff}{F_0+(1-F_0)(1-H{\\cdot}V)^5}\\end{aligned}",
 "diffuse": "\\begin{aligned}L_d &= \\lit{1}{#8fe3a0}{\\dfrac{\\mathrm{albedo}}{\\pi}\\,(N{\\cdot}L)}\\\\[3pt]&\\quad\\cdot\\lit{2}{#8fe3a0}{\\big(1-F_r(N{\\cdot}V)\\big)}\\\\[3pt]F_r &= F_0+\\big(\\lit{3}{#ff8fc8}{\\max(1-r,\\ F_0)}-F_0\\big)\\\\[3pt]&\\quad\\cdot(1-N{\\cdot}V)^5\\end{aligned}",
 "multiscatter": "\\begin{aligned}\\mathrm{comp} &= 1+\\lit{2}{#ff8fc8}{F_0}\\left(\\dfrac{1}{\\lit{1}{#64dfd1}{A+B}}-1\\right)\\end{aligned}",
 "pointlight": "\\begin{aligned}E &= \\lit{1}{#eef6ff}{\\dfrac{I}{\\max(d^2,\\ 10^{-6})}}\\,\\lit{2}{#ffd98a}{\\big(1-f^2\\big)^2}\\\\[3pt]f &= d^2\\,/\\,\\lit{3}{#ffd98a}{r^2}\\end{aligned}",
 "ibl": "\\begin{aligned}L_s &= \\lit{1}{#ff6fb5}{L_{\\mathrm{pre}}(R,\\ 5\\,r)}\\,\\lit{2}{#ffa14a}{(F_0\\,A+B)}\\,\\lit{3}{#eef6ff}{\\mathrm{comp}}\\\\[3pt]L_d &= \\lit{4}{#8fe3a0}{\\mathrm{albedo}\\cdot E(N)\\,/\\,\\pi}\\end{aligned}",
 "clearcoat": "\\begin{aligned}F_0 &\\leftarrow \\lit{1}{#ff8fc8}{\\mathrm{lerp}(F_0,\\ f^2,\\ c)}\\\\[2.5pt]f &= (1-5\\sqrt{F_0})\\,/\\,(5-\\sqrt{F_0})\\\\[2.5pt]F_c &= \\lit{2}{#b49cff}{F(H{\\cdot}L,\\ 0.04)\\,c}\\\\[2.5pt]f_s &\\leftarrow \\lit{3}{#ff8fc8}{f_s\\,(1-F_c)}+\\lit{2}{#b49cff}{D_c\\,G_c\\,F_c\\,(N{\\cdot}L)}\\\\[2.5pt]G_c &= 0.25\\,/\\,\\max\\big((H{\\cdot}L)^2,\\ 10^{-4}\\big)\\\\[2.5pt]f_d &\\leftarrow \\lit{4}{#8fe3a0}{f_d\\,\\big(1-F(H{\\cdot}V,\\ 0.04)\\,c\\big)}\\end{aligned}",
 "culling": "\\begin{aligned}&\\lit{1}{#64dfd1}{\\big\\|\\max(0,\\ |c-p|-h)\\big\\|^2} < r^2\\\\[1pt]&\\lit{2}{#64dfd1}{\\mathrm{mask}\\wedge\\mathrm{bits}(z\\pm r)} \\ne 0\\\\[1pt]\\mathrm{bin} &= \\lit{3}{#ffd166}{\\lfloor \\min(f,\\ 0.999999)\\,2^k\\rfloor}\\\\[1pt]f &= (z-z_n)\\,/\\,(z_f-z_n)\\\\[1pt]k &= \\mathrm{round}(\\mathrm{clamp}(\\ell,\\ 0,\\ 3))\\\\[1pt]\\ell &= \\log_2(z_f-z_n)\\end{aligned}",
 "decals": "\\begin{aligned}a &= \\lit{1}{#64dfd1}{\\alpha\\cdot\\mathrm{opacity}\\cdot\\mathrm{lerp}(1,\\ s,\\ k)}\\\\[3pt]s &= \\lit{1}{#64dfd1}{\\mathrm{smoothstep}(0.55,\\ 1,\\ N_v{\\cdot}z)}\\\\[3pt]\\mathrm{albedo} &\\leftarrow \\lit{2}{#8fe3a0}{\\mathrm{lerp}(\\mathrm{albedo},\\ b,\\ a)}\\\\[3pt]F_0 &\\leftarrow \\lit{3}{#ff8fc8}{\\mathrm{lerp}(F_0,\\ b,\\ a\\,m)}\\\\[3pt]b &= c\\,f\\,\\mathrm{base}\\\\[3pt]N &\\leftarrow \\lit{4}{#6be3b0}{\\mathrm{norm}\\,\\mathrm{lerp}(N,\\ N_{\\mathrm{map}},\\ a_n)}\\end{aligned}",
 "transmission": "\\begin{aligned}T &= \\lit{1}{#8fb8ff}{\\mathrm{sat}\\big(V{\\cdot}{-}\\widehat{(L+N\\,d)}\\big)^{p}\\,s}\\\\[3pt]A &= \\lit{2}{#64dfd1}{e^{-t\\,k}\\,\\mathrm{sat}(1-t)}\\\\[3pt]t &= \\max(0,\\ \\mathrm{thickness})\\\\[3pt]L_d &\\mathrel{+}= \\lit{3}{#8fe3a0}{\\mathrm{tint}\\cdot T\\,A\\,E_L}\\end{aligned}",
 "reflections": "\\begin{aligned}w_i &= \\lit{1}{#64dfd1}{1 \\text{ in inner}_i,\\ \\text{else } \\ell_i}\\\\[3pt]W &= \\lit{1}{#64dfd1}{\\textstyle\\sum_i w_i}\\\\[3pt]R &= \\lit{2}{#ffd98a}{(1-\\min(W,1))\\,G}\\\\[3pt]&\\quad+\\lit{3}{#ff6fb5}{\\textstyle\\sum_i P_i\\,w_i\\,/\\max(1,W)}\\\\[3pt]R_{\\text{inner}} &= \\lit{3}{#ff6fb5}{P_{\\text{last}}}\\end{aligned}",
 "ssao": "\\begin{aligned}w_k &= \\lit{1}{#64dfd1}{1\\,/\\,(|o_k-p|^2+0.07)}\\\\[3pt]\\mathrm{AO} &= \\lit{1}{#64dfd1}{\\textstyle\\sum_k w_k\\,\\mathrm{sat}(n\\cdot\\hat d_k)\\,/\\sum_k w_k}\\\\[3pt]v &= \\lit{2}{#ffd98a}{(1-\\mathrm{AO}\\cdot s)^{2.2}},\\ \\ 52\\ \\text{samples}\\\\[3pt]L_d &\\leftarrow \\lit{3}{#8fe3a0}{L_d\\cdot \\mathrm{up}(\\mathrm{blur}(v))}\\end{aligned}"
}
