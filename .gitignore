# Rust: build output, the crate cache, and the vendored crates (recreated by setup.sh).
target/
.cache/
vendor/

# Python bytecode anywhere.
__pycache__/
*.py[cod]

# Personal Claude Code settings. The project's skills are in .agents/skills (the Agent Skills layout);
# .claude/skills holds one link per skill for Claude Code, and both stay tracked.
.claude/settings.local.json

# Editors and operating systems.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# The optional commercial module, not provided in this repo (see build.rs).
/src/commercial/

# Video builds (tools/video): intermediates and deliverables, and the Node packages.
/build/
/tools/video/node_modules/
