# Rust: build output, the crate cache, and the vendored crates (recreated by setup.sh).
target/
.cache/
vendor/

# Python bytecode anywhere.
__pycache__/
*.py[cod]

# Personal Claude Code settings. The project's skills are in .agents/skills (the Agent Skills layout);
# .claude/skills holds one link per skill for Claude Code, and both stay tracked.
.claude/settings.local.json

# Editors and operating systems.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Generated files, never tracked, so they cannot conflict: the lab's under build/ (screenshots, formula
# renders; the built packages are beside the binary, in target/), and each package's under its build/ (its
# video builds and the timelines the homepage plays, tools/video). And the video tools' Node packages.
/build/
/packages/*/build/
# The guides agents keep in a package while they work on its story (new-story); deleted when it is done.
/packages/**/AGENTS.md
/tools/video/node_modules/
